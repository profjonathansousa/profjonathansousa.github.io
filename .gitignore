# Backups do Cronograma: contêm o seu estado inteiro. Nunca no repositório.
cronograma-backup-*.json
backup-cronograma-*.json

# Ruído do macOS
.DS_Store
**/.DS_Store

# Cache local
__pycache__/
*.pyc

# Copias que o patch deixa ao lado do arquivo. O device_bash nao apaga,
# entao ficam onde estao — mas nunca entram no repositorio.
*.antes-*

# Dependencias instaladas (o avisos/ usa npm ci no Actions)
node_modules/

# A copia publica do historico do Cronograma saiu do repositorio em 2026-10-13,
# a pedido do autor: o estado e o historico moram no Supabase (cron_estado e
# cron_registro), que e privado. Nada aqui deve recria-la — nem a dobra
# (scripts/dobrar_toques.py), se um toque antigo reaparecer.
Cronograma/estado.json
Cronograma/toques/
